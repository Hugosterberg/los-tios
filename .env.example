# Shopping, expenses, employees, shifts: use the hosted API when VITE_BASE44_APP_ID and
# VITE_BASE44_BACKEND_URL are set (dev and prod). localStorage is not used unless you opt in below.
VITE_BASE44_APP_ID=your_app_id
VITE_BASE44_BACKEND_URL=https://your-backend.example
VITE_BASE44_APP_BASE_URL=https://your-backend.example
VITE_LOCAL_DEV_BYPASS_AUTH=false
# Set true only for offline UI work without the API; otherwise leave unset/false so data goes to the database.
VITE_LOCAL_DEV_FINANCE=
VITE_CLIP_API_KEY=your_clip_api_key
VITE_CLIP_API_SECRET=your_clip_api_secret
# Optional alternative:
# VITE_CLIP_API_TOKEN=Basic base64(api_key:api_secret)
VITE_LOYVERSE_API_TOKEN=9fc26c883b2647329d21367cff77697c
VITE_LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
# Optional: menu write-back to Loyverse is disabled by default.
# Set true only if your Loyverse setup supports catalog write operations.
VITE_LOYVERSE_WRITE_MENU=false

# Optional Notion internal integration secret (same value you can paste in Integrations → Notion in the app).
# Get it from https://www.notion.so/my-integrations → your integration → Secrets → Internal integration secret (starts with secret_).
# VITE_NOTION_INTERNAL_TOKEN=secret_...
# Optional: only on the deployed notionProxy server function (not bundled in the browser).
# NOTION_INTEGRATION_TOKEN=secret_...

# Public restaurant page: Google aggregate rating + review count (Maps JavaScript API + Places).
# Restrict the key by HTTP referrer in Google Cloud. Enable "Maps JavaScript API" and "Places API".
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACE_ID=
