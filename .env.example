# Local dev mode. Shopping data and purchases are stored in this browser only — Base44
# is not configured or is still a placeholder. Add VITE_BASE44_APP_ID and VITE_BASE44_BACKEND_URL
# in .env to use the real backend. Set VITE_LOCAL_DEV_FINANCE=false to force API calls in dev once configured.
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_BACKEND_URL=https://app.base44.com
VITE_BASE44_APP_BASE_URL=https://app.base44.com
VITE_LOCAL_DEV_BYPASS_AUTH=false
# When true, Shopping + expenses on /shoppinglist use localStorage in dev (overrides auto-detect).
# When false, always use Base44 for shopping flows in dev (after setting app id + backend URL).
VITE_LOCAL_DEV_FINANCE=
VITE_CLIP_API_KEY=your_clip_api_key
VITE_CLIP_API_SECRET=your_clip_api_secret
# Optional alternative:
# VITE_CLIP_API_TOKEN=Basic base64(api_key:api_secret)
VITE_LOYVERSE_API_TOKEN=9fc26c883b2647329d21367cff77697c
VITE_LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
