{
  "name": "CompanyTransaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "contribution",
        "withdrawal"
      ],
      "description": "Tipo de transacci\u00f3n / Transaction type"
    },
    "contributor_name": {
      "type": "string",
      "description": "Nombre del contribuyente"
    },
    "amount": {
      "type": "number",
      "description": "Monto de la transacci\u00f3n en MXN"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la transacci\u00f3n"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "transfer",
        "check",
        "other"
      ],
      "default": "cash",
      "description": "M\u00e9todo de pago/retiro"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n de la transacci\u00f3n"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "reference_number": {
      "type": "string",
      "description": "N\u00famero de referencia bancaria"
    }
  },
  "required": [
    "type",
    "contributor_name",
    "amount",
    "date"
  ]
}