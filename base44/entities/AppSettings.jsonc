{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "restaurant_name": {
      "type": "string",
      "default": "Los Tios",
      "description": "Nombre del restaurante"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logo principal"
    },
    "primary_color": {
      "type": "string",
      "default": "#DC2626",
      "description": "Color primario (rojo)"
    },
    "secondary_color": {
      "type": "string",
      "default": "#F97316",
      "description": "Color secundario (naranja)"
    },
    "accent_color": {
      "type": "string",
      "default": "#10B981",
      "description": "Color de acento (verde)"
    },
    "text_color": {
      "type": "string",
      "default": "#111827",
      "description": "Color del texto principal"
    },
    "background_color": {
      "type": "string",
      "default": "#F9FAFB",
      "description": "Color de fondo"
    },
    "theme_style": {
      "type": "string",
      "enum": [
        "modern",
        "classic",
        "elegant",
        "playful"
      ],
      "default": "modern",
      "description": "Estilo del tema"
    },
    "phone_number": {
      "type": "string",
      "description": "Tel\u00e9fono del restaurante"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n del restaurante"
    },
    "email": {
      "type": "string",
      "description": "Email del restaurante"
    },
    "accept_cash": {
      "type": "boolean",
      "default": true,
      "description": "Aceptar pagos en efectivo"
    },
    "accept_card": {
      "type": "boolean",
      "default": true,
      "description": "Aceptar pagos con tarjeta"
    },
    "bank_name": {
      "type": "string",
      "description": "Nombre del banco"
    },
    "bank_account_number": {
      "type": "string",
      "description": "N\u00famero de cuenta bancaria"
    },
    "bank_account_holder": {
      "type": "string",
      "description": "Titular de la cuenta"
    },
    "clabe": {
      "type": "string",
      "description": "CLABE interbancaria"
    },
    "clip_payment_link": {
      "type": "string",
      "description": "Link de pago de Clip"
    },
    "clip_api_key": {
      "type": "string",
      "description": "Clave p\u00fablica de Clip"
    },
    "clip_api_secret": {
      "type": "string",
      "description": "Clave secreta de Clip"
    },
    "clip_api_token": {
      "type": "string",
      "description": "Token de autenticaci\u00f3n de Clip (opcional, se genera autom\u00e1ticamente)"
    },
    "clip_payments_api_base_url": {
      "type": "string",
      "default": "https://api.payclip.com",
      "description": "URL base de la API de pagos de Clip"
    },
    "clip_settlements_api_base_url": {
      "type": "string",
      "default": "https://api-gw.payclip.com",
      "description": "URL base de la API de conciliaciones de Clip"
    },
    "loyverse_public_key": {
      "type": "string",
      "description": "Clave p\u00fablica de Loyverse (opcional)"
    },
    "loyverse_api_token": {
      "type": "string",
      "description": "Token secreto de la API de Loyverse"
    },
    "loyverse_api_base_url": {
      "type": "string",
      "default": "https://api.loyverse.com/v1.0",
      "description": "URL base de la API de Loyverse"
    },
    "customer_events_json": {
      "type": "string",
      "description": "JSON array of customer-facing events created in the admin Events page"
    }
  },
  "required": [
    "restaurant_name"
  ]
}
