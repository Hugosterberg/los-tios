{
  "name": "Review",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string"
    },
    "visit_date": {
      "type": "string",
      "format": "date"
    },
    "dish_ordered": {
      "type": "string"
    }
  },
  "required": [
    "customer_name",
    "rating",
    "comment"
  ]
}